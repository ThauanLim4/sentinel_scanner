# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Ambientes virtuais
.venv/
venv/
env/

# Ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Executável / empacotamento (etapa futura)
*.spec
*.exe
*.msi

# Configuração local e segredos
.env
.env.*
*.pem
*.key

# Dados de execução (não versionar)
logs/*
!logs/.gitkeep
data/sentinel.db
data/sentinel.db-*
data/keys/
data/backups/
quarantine/*
!quarantine/.gitkeep
reports/*
!reports/.gitkeep

# Listas locais de assinaturas (podem ser baixadas/geradas pelo usuário)
data/signatures/*
!data/signatures/.gitkeep

# Sistema
Thumbs.db
Desktop.ini
.DS_Store
